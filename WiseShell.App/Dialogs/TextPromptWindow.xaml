<Window x:Class="WiseShell.App.Dialogs.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="220"
        Width="460"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="PromptText" Margin="0,0,0,14" FontSize="14" />
            <TextBox x:Name="ValueTextBox" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Width="96" Margin="0,0,10,0" Click="Cancel_OnClick" Content="取消" />
            <Button Width="96" Click="Confirm_OnClick" Content="确定" />
        </StackPanel>
    </Grid>
</Window>
