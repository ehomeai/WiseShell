<Window x:Class="WiseShell.App.Dialogs.SessionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑会话"
        Width="860"
        Height="760"
        MinWidth="820"
        MinHeight="740"
        FontFamily="Microsoft YaHei UI"
        Background="#FFF4F7FB"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFCCD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF16324F" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#FF4A5A6A" />
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="BorderBrush" Value="#FFBFCBDA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="#FFBFCBDA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,5" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,10"
                Padding="14,11"
                Background="#FFEAF2FB"
                BorderBrush="#FFC7D7EA"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <TextBlock FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#FF16324F"
                           Text="会话设置" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="#FF58708A"
                           Text="配置连接、目录和终端外观。" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,8,8"
                    Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="基本信息" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="名称" />
                        <TextBlock Grid.Column="1" Style="{StaticResource FieldLabelStyle}" Text="端口" />
                        <TextBox Grid.Column="0" Style="{StaticResource InputTextBoxStyle}" Margin="0,22,8,8" Text="{Binding Name}" />
                        <TextBox Grid.Column="1" Style="{StaticResource InputTextBoxStyle}" Margin="0,22,0,8" Text="{Binding Port}" />
                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="分组路径" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding GroupPath}" />

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="主机" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding Host}" />

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="用户名" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding Username}" />

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="认证方式" />
                    <ComboBox x:Name="AuthTypeComboBox"
                              Style="{StaticResource InputComboBoxStyle}"
                              SelectedItem="{Binding AuthType}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="1"
                    Margin="8,0,0,8"
                    Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="默认目录" />

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="本地目录" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Margin="0,0,8,0"
                                 Text="{Binding LocalStartupDirectory}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="BrowseLocalDirectory_OnClick"
                                Content="浏览" />
                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="远程目录" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Margin="0,0,8,0"
                                 Text="{Binding StartupDirectory}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="BrowseRemoteDirectory_OnClick"
                                Content="选择" />
                    </Grid>

                    <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0,6,0,10" Text="终端外观" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="终端主题" />
                        <TextBlock Grid.Column="1" Style="{StaticResource FieldLabelStyle}" Text="保活秒数" />
                        <ComboBox x:Name="ThemeComboBox"
                                  Grid.Column="0"
                                  Style="{StaticResource InputComboBoxStyle}"
                                  Margin="0,22,8,8"
                                  SelectedItem="{Binding TerminalTheme}" />
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Margin="0,22,0,8"
                                 Text="{Binding KeepAliveSeconds}" />
                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="终端字体" />
                    <ComboBox x:Name="FontFamilyComboBox"
                              Style="{StaticResource InputComboBoxStyle}"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              Text="{Binding TerminalFontFamily, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="字号" />
                        <TextBlock Grid.Column="1" Style="{StaticResource FieldLabelStyle}" Text="滚动缓冲" />
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Margin="0,22,8,8"
                                 Text="{Binding FontSize}" />
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Margin="0,22,0,8"
                                 Text="{Binding ScrollbackLines}" />
                    </Grid>

                    <CheckBox Margin="0,2,0,0"
                              Content="加入收藏"
                              IsChecked="{Binding IsFavorite}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="凭据设置" />

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="私钥路径" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Margin="0,0,8,0"
                                 Text="{Binding PrivateKeyPath}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="BrowsePrivateKey_OnClick"
                                Content="浏览" />
                    </Grid>

                    <Border Margin="0,0,0,8"
                            Padding="10"
                            Background="#FFF8FAFD"
                            BorderBrush="#FFD6E0EA"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel>
                            <CheckBox Content="记住密码 / 私钥口令"
                                      IsChecked="{Binding RememberSecret}" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="#FF66788A"
                                       FontSize="12"
                                       Text="勾选后使用 Windows 安全存储保存凭据。" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="凭据内容" />
                    <PasswordBox x:Name="SecretPasswordBox"
                                 Height="32"
                                 Padding="10,5"
                                 BorderBrush="#FFBFCBDA"
                                 BorderThickness="1"
                                 Background="White"
                                 PasswordChanged="SecretPasswordBox_OnPasswordChanged" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#FF66788A"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="留空表示保持已保存凭据不变；取消“记住”后会删除已保存内容。" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="说明" />
                    <TextBlock TextWrapping="Wrap"
                               Foreground="#FF5C7088"
                               LineHeight="20"
                               Text="本地目录会作为 SFTP 打开时的默认本机路径，远程目录会作为默认远端路径。Password 可直接填写密码；PrivateKey 建议同时配置私钥路径和口令。" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="12"
                Background="White"
                BorderBrush="#FFCCD5E1"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Width="96"
                        Height="32"
                        Margin="0,0,10,0"
                        Click="Cancel_OnClick"
                        Content="取消" />
                <Button Width="96"
                        Height="32"
                        Click="Save_OnClick"
                        Content="保存" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
