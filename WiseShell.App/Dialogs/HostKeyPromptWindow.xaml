<Window x:Class="WiseShell.App.Dialogs.HostKeyPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="360"
        Width="620"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Title="确认主机指纹">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Margin="0,0,0,16"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="这是该主机的首次连接，请确认以下主机指纹是否可信。" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,12" FontWeight="SemiBold" Text="主机" />
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" Text="{Binding Host}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,12" FontWeight="SemiBold" Text="端口" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" Text="{Binding Port}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,12" FontWeight="SemiBold" Text="算法" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" Text="{Binding Algorithm}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,12,12" FontWeight="SemiBold" Text="SHA256" />
                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" Text="{Binding FingerprintSha256}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,12,12" FontWeight="SemiBold" Text="MD5" />
                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,12" Text="{Binding FingerprintMd5}" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Width="120" Margin="0,0,10,0" Click="Reject_OnClick" Content="拒绝连接" />
            <Button Width="120" Click="Accept_OnClick" Content="信任并连接" />
        </StackPanel>
    </Grid>
</Window>
