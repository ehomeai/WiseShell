<Window x:Class="WiseShell.App.Dialogs.TerminalDefaultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="终端字体设置"
        Width="520"
        Height="280"
        FontFamily="Microsoft YaHei UI"
        Background="#FFF8F8F8"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Margin="0,0,12,12"
                       VerticalAlignment="Center"
                       Text="默认字号" />
            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Margin="0,0,0,12"
                     Text="{Binding FontSize}" />

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Margin="0,0,12,12"
                       VerticalAlignment="Center"
                       Text="默认字体" />
            <ComboBox x:Name="FontFamilyComboBox"
                      Grid.Row="1"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Margin="0,0,12,12"
                       VerticalAlignment="Top"
                       Text="说明" />
            <TextBlock Grid.Row="2"
                       Grid.Column="1"
                       Margin="0,0,0,12"
                       Foreground="#FF4B5563"
                       TextWrapping="Wrap"
                       Text="这里设置的是默认终端字体外观。新建会话会自动继承；勾选下面选项后，还会同步更新当前仍在使用旧默认值的会话和已打开终端。" />

            <CheckBox Grid.Row="3"
                      Grid.Column="1"
                      Content="同时应用到现有会话和已打开终端（仅覆盖仍在使用旧默认值的项）"
                      IsChecked="{Binding ApplyToMatchingSessions}" />
        </Grid>

        <StackPanel Grid.Row="1"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="96"
                    Margin="0,0,10,0"
                    Click="Cancel_OnClick"
                    Content="取消" />
            <Button Width="96"
                    Click="Save_OnClick"
                    Content="保存" />
        </StackPanel>
    </Grid>
</Window>
