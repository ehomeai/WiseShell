<Window x:Class="WiseShell.App.Dialogs.SecretPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560"
        Height="370"
        MinWidth="560"
        MinHeight="370"
        Background="#FFF3F4F6"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Margin="0"
            Background="#FFF7F7F9"
            BorderBrush="#FFD3D8DF"
            BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="84" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      Margin="0,2,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Margin="0,0,10,8"
                               Foreground="#FF475569"
                               Text="远程主机:" />
                    <TextBlock x:Name="HostText"
                               Grid.Row="0"
                               Grid.Column="1"
                               Margin="0,0,0,8"
                               FontWeight="SemiBold"
                               Foreground="#FF0F172A"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Margin="0,0,10,8"
                               Foreground="#FF475569"
                               Text="鐧诲綍鍚?" />
                    <TextBlock x:Name="UsernameText"
                               Grid.Row="1"
                               Grid.Column="1"
                               Margin="0,0,0,8"
                               FontWeight="SemiBold"
                               Foreground="#FF0F172A"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Margin="0,0,10,0"
                               Foreground="#FF475569"
                               Text="认证方式:" />
                    <TextBlock x:Name="ServiceTypeText"
                               Grid.Row="2"
                               Grid.Column="1"
                               FontWeight="SemiBold"
                               Foreground="#FF0F172A"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <Border Grid.Column="1"
                        Width="68"
                        Height="68"
                        CornerRadius="10"
                        Background="#FFFFFFFF"
                        BorderBrush="#FFD5DCE6"
                        BorderThickness="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                    <Image Width="44"
                           Height="44"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Source="{StaticResource AppWindowLogo}" />
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,0,0,14"
                    Padding="12,10"
                    Background="#FFFAF2D8"
                    BorderBrush="#FFE4D6A7"
                    BorderThickness="1">
                <TextBlock x:Name="PromptMessage"
                           FontWeight="SemiBold"
                           Foreground="#FF4B3F1C" />
            </Border>

            <Border Grid.Row="2"
                    Background="#FFFDFDFE"
                    BorderBrush="#FFD2D9E3"
                    BorderThickness="1">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="CredentialSectionTitle"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#FF1F2937" />

                    <Grid Grid.Row="1"
                          Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="SecretLabel"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   Margin="0,6,10,0"
                                   VerticalAlignment="Top"
                                   Foreground="#FF334155" />
                        <PasswordBox x:Name="SecretPasswordBox"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Height="30"
                                     Padding="8,4"
                                     VerticalContentAlignment="Center" />

                        <TextBlock x:Name="PrivateKeyPathLabel"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,12,10,0"
                                   VerticalAlignment="Top"
                                   Foreground="#FF334155"
                                   Text="私钥文件:"
                                   Visibility="Collapsed" />
                        <TextBox x:Name="PrivateKeyPathTextBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="0,12,0,0"
                                 Padding="8,4"
                                 Background="#FFF3F4F6"
                                 BorderBrush="#FFD0D7E2"
                                 IsReadOnly="True"
                                 Visibility="Collapsed" />
                    </Grid>

                    <TextBlock x:Name="HintText"
                               Grid.Row="2"
                               Margin="0,12,0,0"
                               Foreground="#FF64748B"
                               FontSize="12"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <DockPanel Grid.Row="3"
                       Margin="0,16,0,0"
                       LastChildFill="False">
                <CheckBox x:Name="RememberSecretCheckBox"
                          VerticalAlignment="Center"
                          Foreground="#FF0F172A" />

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button Width="98"
                            Height="30"
                            Margin="0,0,10,0"
                            IsDefault="True"
                            Click="Confirm_OnClick"
                            Content="确定" />
                    <Button Width="98"
                            Height="30"
                            IsCancel="True"
                            Click="Cancel_OnClick"
                            Content="取消" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
