<Window x:Class="WiseShell.App.Dialogs.RemoteDirectoryPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择远程目录"
        Width="820"
        Height="620"
        MinWidth="700"
        MinHeight="520"
        FontFamily="Microsoft YaHei UI"
        Background="#FFF4F7FB"
        WindowStartupLocation="CenterOwner"
        Closing="Window_OnClosing">
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Height" Value="34" />
        </Style>

        <Style x:Key="PaneBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFBCC8D5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <DataTemplate x:Key="DirectoryNameTemplate">
            <StackPanel Orientation="Horizontal">
                <Grid Width="16"
                      Height="16"
                      Margin="0,0,6,0">
                    <Border Margin="1,4,1,1"
                            Background="#FFF0C45A"
                            BorderBrush="#FFD2A23B"
                            BorderThickness="1"
                            CornerRadius="1" />
                    <Border Width="7"
                            Height="4"
                            Margin="2,1,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#FFF8D97B"
                            BorderBrush="#FFD2A23B"
                            BorderThickness="1,1,1,0"
                            CornerRadius="1,1,0,0" />
                </Grid>
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding Name}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,12">
            <TextBlock FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="#FF16324F"
                       Text="选择远程目录" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="#FF58708A"
                       Text="双击目录进入，或直接输入路径后按回车。" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource PaneBorderStyle}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           Margin="0,0,0,10">
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Click="NavigateUp_OnClick"
                            Content="上级"
                            IsEnabled="{Binding CanNavigateUp}" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Click="Refresh_OnClick"
                            Content="刷新" />
                    <TextBox Margin="0,0,8,0"
                             Padding="10,6"
                             VerticalContentAlignment="Center"
                             KeyDown="PathTextBox_OnKeyDown"
                             Text="{Binding PathInput, UpdateSourceTrigger=PropertyChanged}" />
                    <Button MinWidth="86"
                            Height="34"
                            Padding="12,6"
                            Click="Go_OnClick"
                            Content="进入" />
                </DockPanel>

                <DataGrid Grid.Row="1"
                          AutoGenerateColumns="False"
                          ItemsSource="{Binding Entries}"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          BorderThickness="0"
                          Background="White"
                          AlternatingRowBackground="#FFFBFCFE"
                          MouseDoubleClick="EntriesGrid_OnMouseDoubleClick"
                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*"
                                                Header="目录名"
                                                CellTemplate="{StaticResource DirectoryNameTemplate}" />
                        <DataGridTextColumn Width="180"
                                            Binding="{Binding LastWriteDisplay}"
                                            Header="最近修改" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="12,8"
                Background="#FFF8FAFD"
                BorderBrush="#FFD6E0EA"
                BorderThickness="1"
                CornerRadius="6">
            <TextBlock Text="{Binding StatusText}" />
        </Border>

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="12"
                Background="White"
                BorderBrush="#FFCCD5E1"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Width="96"
                        Height="34"
                        Margin="0,0,10,0"
                        Click="Cancel_OnClick"
                        Content="取消" />
                <Button Width="124"
                        Height="34"
                        Click="SelectCurrent_OnClick"
                        Content="选择当前目录" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
