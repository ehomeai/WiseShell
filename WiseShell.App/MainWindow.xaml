<Window x:Class="WiseShell.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:WiseShell.App.Controls"
        xmlns:viewModels="clr-namespace:WiseShell.App.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1500"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        Background="#FFF1F1F1"
        FontFamily="Microsoft YaHei UI"
        Loaded="Window_OnLoaded"
        Closing="Window_OnClosing">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type viewModels:SessionExplorerItemViewModel}" ItemsSource="{Binding Children}">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="FolderNodeIcon"
                           Margin="0,0,6,0"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="#FFC49A00"
                           Text="&#xE8B7;" />
                <Image x:Name="SessionNodeIcon"
                       Width="14"
                       Height="14"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Source="{StaticResource AppWindowLogo}"
                       Visibility="Collapsed" />
                <Grid>
                    <TextBlock x:Name="NodeNameText"
                               VerticalAlignment="Center"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=Foreground}"
                               Text="{Binding DisplayName}" />
                    <TextBox x:Name="NodeRenameTextBox"
                             MinWidth="90"
                             Margin="-2,-2,0,-2"
                             Padding="1,0"
                             VerticalAlignment="Center"
                             BorderBrush="#FF0E87D5"
                             IsVisibleChanged="SessionRenameTextBox_OnIsVisibleChanged"
                             KeyDown="SessionRenameTextBox_OnKeyDown"
                             LostFocus="SessionRenameTextBox_OnLostFocus"
                             Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="Collapsed" />
                </Grid>
            </DockPanel>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="False">
                    <Setter TargetName="FolderNodeIcon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="SessionNodeIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditingName}" Value="True">
                    <Setter TargetName="NodeNameText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="NodeRenameTextBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type viewModels:TerminalTabViewModel}">
            <controls:TerminalWebView />
        </DataTemplate>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Background" Value="#FFF9F9F9" />
            <Setter Property="BorderBrush" Value="#FFC6CCD6" />
            <Setter Property="Foreground" Value="#FF1F2937" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF8FB5E8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFE3EEF9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF9AA4B2" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFF2F3F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF6B7280" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#33000000" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="CloseBorder" Property="Background" Value="#FFE8EAEE" />
                                <Setter Property="Foreground" Value="#FF111827" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="CloseBorder" Property="Background" Value="#22000000" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabAddButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#FFF8FAFC" />
            <Setter Property="BorderBrush" Value="#FFC0C7D1" />
            <Setter Property="Foreground" Value="#FF334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="AddBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AddBorder" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="AddBorder" Property="BorderBrush" Value="#FF97A6BA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="AddBorder" Property="Background" Value="#FFE6EDF6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClassicTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="#FFE1E7EF" />
            <Setter Property="BorderBrush" Value="#FFBBC6D3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local"
                              SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1,1,1,0"
                                    Padding="3,3,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <TabPanel IsItemsHost="True"
                                              Background="Transparent" />
                                    <Button Style="{StaticResource TabAddButtonStyle}"
                                            VerticalAlignment="Top"
                                            Command="{Binding DataContext.NewSessionCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                            Content="+" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1"
                                    Background="Black"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClassicTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF111827" />
            <Setter Property="BorderBrush" Value="#FFC0C7D1" />
            <Setter Property="Padding" Value="10,4,8,4" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFDFEFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FF0E87D5" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#FF0E87D5" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Panel.ZIndex" Value="10" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TreeView}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="0,1,0,1" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF0078D4" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PropertyLabelCellStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FFD0D6DE" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Background" Value="#FFF4F6F8" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style x:Key="PropertyValueCellStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FFD0D6DE" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0"
              Background="#FFF7F7F7"
              BorderBrush="#FFD1D6DE"
              BorderThickness="0,0,0,1">
            <MenuItem Header="文件(F)">
                <MenuItem Header="新建会话" Command="{Binding NewSessionCommand}" />
                <MenuItem Header="连接" Command="{Binding ConnectSessionCommand}" />
                <Separator />
                <MenuItem Header="刷新会话列表" Command="{Binding RefreshSessionsCommand}" />
            </MenuItem>
            <MenuItem Header="编辑(E)">
                <MenuItem Header="编辑会话" Command="{Binding EditSessionCommand}" />
                <MenuItem Header="重命名会话" Command="{Binding RenameSessionCommand}" />
                <MenuItem Header="复制会话" Command="{Binding DuplicateSessionCommand}" />
                <MenuItem Header="删除会话" Command="{Binding DeleteSessionCommand}" />
                <Separator />
                <MenuItem Header="新建文件夹" Command="{Binding NewFolderCommand}" />
                <MenuItem Header="重命名文件夹" Command="{Binding RenameFolderCommand}" />
                <MenuItem Header="删除文件夹" Command="{Binding DeleteFolderCommand}" />
                <Separator />
                <MenuItem Header="重命名标签" Command="{Binding RenameTabCommand}" />
            </MenuItem>
            <MenuItem Header="查看(V)">
                <MenuItem Header="打开 SFTP" Command="{Binding OpenSftpCommand}" />
                <MenuItem Header="刷新" Command="{Binding RefreshSessionsCommand}" />
            </MenuItem>
            <MenuItem Header="工具(T)">
                <MenuItem Header="断开连接" Command="{Binding DisconnectSessionCommand}" />
                <MenuItem Header="重新连接" Command="{Binding ReconnectSessionCommand}" />
            </MenuItem>
            <MenuItem Header="选项(O)">
                <MenuItem Header="终端字体设置" Command="{Binding EditTerminalDefaultsCommand}" />
            </MenuItem>
            <MenuItem Header="窗口(W)" IsEnabled="False" />
            <MenuItem Header="帮助(H)" IsEnabled="False" />
        </Menu>

        <Border Grid.Row="1"
                Background="#FFF5F5F5"
                BorderBrush="#FFD1D6DE"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ToolBarTray Grid.Row="0"
                             Background="#FFF5F5F5"
                             IsLocked="True">
                    <ToolBar Background="#FFF5F5F5"
                             BorderThickness="0"
                             Padding="4,2">
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding NewSessionCommand}" Content="新建" />
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding EditSessionCommand}" Content="编辑" />
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding DuplicateSessionCommand}" Content="复制" />
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding DeleteSessionCommand}" Content="删除" />
                        <Separator />
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ConnectSessionCommand}" Content="连接" />
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding DisconnectSessionCommand}" Content="断开" />
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ReconnectSessionCommand}" Content="重连" />
                        <Separator />
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenSftpCommand}" Content="SFTP" />
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RefreshSessionsCommand}" Content="刷新" />
                    </ToolBar>
                </ToolBarTray>

                <Border Grid.Row="1"
                        Background="#FFFDFEFF"
                        BorderBrush="#FFE1E5EB"
                        BorderThickness="0,1,0,0"
                        Padding="10,5">
                    <DockPanel>
                        <TextBlock Margin="0,0,8,0"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="#FF2B88D8"
                                   Text="&#xE946;" />
                        <TextBlock Foreground="#FF7B8796"
                                   Text="要添加或连接会话，请先从左侧选择一个会话，双击即可直接连接。" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#FFF7F7F7"
                    BorderBrush="#FFBEC6D1"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="170" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#FF0E87D5"
                            Padding="8,6">
                        <DockPanel>
                            <TextBlock Foreground="White"
                                       FontWeight="SemiBold"
                                       Text="会话管理器" />
                            <TextBlock DockPanel.Dock="Right"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="#FFDFF3FF"
                                       Text="&#xE721;" />
                        </DockPanel>
                    </Border>

                    <!--<Border Grid.Row="1"
                            Background="#FFF3F6FA"
                            BorderBrush="#FFD7DDE5"
                            BorderThickness="0,0,0,1"
                            Padding="8,5">
                        <TextBlock Foreground="#FF6B7280"
                                   FontSize="12"
                                   Text="提示：双击左侧会话即可在右侧打开终端标签页。" />
                    </Border>-->

                    <TreeView x:Name="SessionTreeView"
                              Grid.Row="2"
                              AllowDrop="True"
                              Padding="6"
                              ItemsSource="{Binding SessionTree}"
                              PreviewMouseLeftButtonDown="SessionTreeView_OnPreviewMouseLeftButtonDown"
                              PreviewMouseMove="SessionTreeView_OnPreviewMouseMove"
                              PreviewMouseRightButtonDown="SessionTreeView_OnPreviewMouseRightButtonDown"
                              PreviewKeyDown="SessionTreeView_OnPreviewKeyDown"
                              ContextMenuOpening="SessionTreeView_OnContextMenuOpening"
                              DragOver="SessionTreeView_OnDragOver"
                              Drop="SessionTreeView_OnDrop"
                              SelectedItemChanged="SessionTreeView_OnSelectedItemChanged"
                              MouseDoubleClick="SessionTreeView_OnMouseDoubleClick">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF0078D4" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF0078D4" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
                        </TreeView.Resources>
                    </TreeView>

                    <GridSplitter Grid.Row="3"
                                  Height="4"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="#FFD0D6DE" />

                    <Border Grid.Row="4"
                            Background="#FFF9F9F9"
                            BorderBrush="#FFD0D6DE"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="#FFEFF2F6"
                                    BorderBrush="#FFD0D6DE"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,5">
                                <TextBlock Foreground="#FF374151"
                                           FontWeight="SemiBold"
                                           Text="属性" />
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PropertyLabelCellStyle}">
                                    <TextBlock Foreground="#FF4B5563" Text="名称" />
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource PropertyValueCellStyle}">
                                    <TextBlock Foreground="#FF111827" Text="{Binding SelectedItemNameText}" />
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PropertyLabelCellStyle}">
                                    <TextBlock Foreground="#FF4B5563" Text="类型" />
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PropertyValueCellStyle}">
                                    <TextBlock Foreground="#FF111827" Text="{Binding SelectedItemTypeText}" />
                                </Border>

                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource PropertyLabelCellStyle}">
                                    <TextBlock Foreground="#FF4B5563" Text="地址" />
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource PropertyValueCellStyle}">
                                    <TextBlock Foreground="#FF111827" Text="{Binding SelectedItemEndpointText}" />
                                </Border>

                                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource PropertyLabelCellStyle}">
                                    <TextBlock Foreground="#FF4B5563" Text="用户" />
                                </Border>
                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource PropertyValueCellStyle}">
                                    <TextBlock Foreground="#FF111827" Text="{Binding SelectedItemUserText}" />
                                </Border>

                                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource PropertyLabelCellStyle}">
                                    <TextBlock Foreground="#FF4B5563" Text="分组" />
                                </Border>
                                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource PropertyValueCellStyle}">
                                    <TextBlock Foreground="#FF111827" Text="{Binding SelectedItemGroupText}" />
                                </Border>

                                <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource PropertyLabelCellStyle}">
                                    <TextBlock Foreground="#FF4B5563" Text="认证方式" />
                                </Border>
                                <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource PropertyValueCellStyle}">
                                    <TextBlock Foreground="#FF111827"
                                               Text="{Binding SelectedItemAuthenticationText}" />
                                </Border>

                                <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource PropertyLabelCellStyle}">
                                    <TextBlock Foreground="#FF4B5563" Text="子项数量" />
                                </Border>
                                <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource PropertyValueCellStyle}">
                                    <TextBlock Foreground="#FF111827"
                                               Text="{Binding SelectedItemChildrenText}" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#FFD0D6DE" />

            <Border Grid.Column="2"
                    Background="#FFF1F1F1"
                    Padding="6,6,0,0">
                <TabControl ItemsSource="{Binding Tabs}"
                            SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                            Style="{StaticResource ClassicTabControlStyle}"
                            ItemContainerStyle="{StaticResource ClassicTabItemStyle}"
                            Background="#FFE1E7EF"
                            BorderBrush="#FFBBC6D3">
                    <TabControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:TerminalTabViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="#FF21B14B" />
                                <TextBlock VerticalAlignment="Center"
                                           MaxWidth="210"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Header}" />
                                <Button Style="{StaticResource TabCloseButtonStyle}"
                                        Command="{Binding CloseCommand}"
                                        Content="×" />
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </TabControl>
            </Border>
        </Grid>

        <StatusBar Grid.Row="3"
                   Background="#FFF7F7F7"
                   BorderBrush="#FFD1D6DE"
                   BorderThickness="0,1,0,0"
                   Padding="4,1"
                   Foreground="#FF374151">
            <StatusBar.Resources>
                <Style TargetType="{x:Type StatusBarItem}">
                    <Setter Property="Padding" Value="8,1" />
                    <Setter Property="Margin" Value="2,0" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style TargetType="{x:Type Separator}">
                    <Setter Property="Margin" Value="6,2" />
                </Style>
            </StatusBar.Resources>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Foreground="#FF4B5563"
                           Text="{Binding SelectedTab.LogStatusText, FallbackValue=日志: 未启用}" />
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Foreground="#FF4B5563"
                           Text="{Binding SelectedTab.TerminalSizeText, FallbackValue=终端尺寸: -- x --}" />
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Foreground="#FF374151"
                           Text="{Binding SelectedTab.StatusText, FallbackValue=就绪}" />
