<Window x:Class="WiseShell.App.Windows.SftpBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Closing="Window_OnClosing">
    <Window.Resources>
        <Style x:Key="PaneButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinWidth" Value="92" />
        </Style>

        <Style x:Key="PaneBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFBCC8D5" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="FileGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="AlternatingRowBackground" Value="#FFFBFCFE" />
        </Style>

        <Style x:Key="LogGridStyle" TargetType="DataGrid" BasedOn="{StaticResource FileGridStyle}">
            <Setter Property="AlternatingRowBackground" Value="#FFF8FAFD" />
        </Style>

        <Style x:Key="RightAlignedCellTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Padding" Value="0,0,8,0" />
        </Style>

        <Style x:Key="RightAlignedHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <DataTemplate x:Key="NameWithIconTemplate">
            <StackPanel Orientation="Horizontal">
                <Grid Width="16"
                      Height="16"
                      Margin="0,0,6,0">
                    <Grid x:Name="FolderIcon"
                          Visibility="Collapsed">
                        <Border Margin="1,4,1,1"
                                Background="#FFF0C45A"
                                BorderBrush="#FFD2A23B"
                                BorderThickness="1"
                                CornerRadius="1" />
                        <Border Width="7"
                                Height="4"
                                Margin="2,1,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#FFF8D97B"
                                BorderBrush="#FFD2A23B"
                                BorderThickness="1,1,1,0"
                                CornerRadius="1,1,0,0" />
                    </Grid>
                    <Grid x:Name="FileIcon"
                          Visibility="Visible">
                        <Border Width="11"
                                Height="14"
                                Margin="2,1,3,1"
                                Background="White"
                                BorderBrush="#FF9AA7B6"
                                BorderThickness="1" />
                        <Polygon Margin="0,1,3,0"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Fill="#FFE8EEF5"
                                 Points="0,0 4,0 4,4" />
                    </Grid>
                </Grid>
                <Grid>
                    <TextBlock x:Name="EntryNameText"
                               VerticalAlignment="Center"
                               Text="{Binding Name}" />
                    <TextBox x:Name="EntryRenameTextBox"
                             MinWidth="120"
                             Margin="-2,-2,0,-2"
                             Padding="1,0"
                             VerticalAlignment="Center"
                             BorderBrush="#FF0E87D5"
                             IsVisibleChanged="FileRenameTextBox_OnIsVisibleChanged"
                             KeyDown="FileRenameTextBox_OnKeyDown"
                             LostFocus="FileRenameTextBox_OnLostFocus"
                             Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="Collapsed" />
                </Grid>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                    <Setter TargetName="FolderIcon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="FileIcon" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                    <Setter TargetName="FolderIcon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="FileIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditingName}" Value="True">
                    <Setter TargetName="EntryNameText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="EntryRenameTextBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="170" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0"
                   Margin="0,0,0,10">
            <Button Click="LocalNavigateUp_OnClick"
                    Content="本地上级"
                    IsEnabled="{Binding CanNavigateLocalUp}"
                    Style="{StaticResource PaneButtonStyle}" />
            <Button Click="LocalRefresh_OnClick"
                    Content="本地刷新"
                    IsEnabled="{Binding CanInteractLocal}"
                    Style="{StaticResource PaneButtonStyle}" />
            <Button Click="Upload_OnClick"
                    Content="上传到远程"
                    IsEnabled="{Binding CanUploadSelection}"
                    Style="{StaticResource PaneButtonStyle}" />
            <Button Click="Download_OnClick"
                    Content="下载到本地"
                    IsEnabled="{Binding CanDownloadSelection}"
                    Style="{StaticResource PaneButtonStyle}" />
            <Button Click="RemoteNavigateUp_OnClick"
                    Content="远程上级"
                    IsEnabled="{Binding CanNavigateRemoteUp}"
                    Style="{StaticResource PaneButtonStyle}" />
            <Button Click="RemoteRefresh_OnClick"
                    Content="远程刷新"
                    IsEnabled="{Binding CanInteractRemote}"
                    Style="{StaticResource PaneButtonStyle}" />
            <Button Click="CreateFolder_OnClick"
                    Content="新建远程目录"
                    IsEnabled="{Binding CanInteractRemote}"
                    Style="{StaticResource PaneButtonStyle}" />
            <Button Click="Delete_OnClick"
                    Content="删除远程项"
                    IsEnabled="{Binding CanDeleteSelection}"
                    Style="{StaticResource PaneButtonStyle}" />
        </WrapPanel>

        <Grid Grid.Row="1"
              Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="8,6"
                    Style="{StaticResource PaneBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="本地站点:" />
                    <ComboBox x:Name="LocalDriveComboBox"
                              Grid.Column="1"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding LocalDrives}"
                              IsEnabled="{Binding CanInteractLocal}"
                              SelectedItem="{Binding SelectedLocalDrive, Mode=OneWay}"
                              SelectionChanged="LocalDriveComboBox_OnSelectionChanged" />
                    <TextBox Grid.Column="3"
                             VerticalContentAlignment="Center"
                             IsEnabled="{Binding CanInteractLocal}"
                             KeyDown="LocalPathTextBox_OnKeyDown"
                             Text="{Binding LocalPathInput, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="8,6"
                    Style="{StaticResource PaneBorderStyle}">
                <DockPanel LastChildFill="True">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="远程站点:" />
                    <TextBox VerticalContentAlignment="Center"
                             IsEnabled="{Binding CanInteractRemote}"
                             KeyDown="RemotePathTextBox_OnKeyDown"
                             Text="{Binding RemotePathInput, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource PaneBorderStyle}">
                <DataGrid x:Name="LocalEntriesGrid"
                          AllowDrop="True"
                          ItemsSource="{Binding LocalEntries}"
                          SelectedItem="{Binding SelectedLocalEntry, Mode=TwoWay}"
                          MouseDoubleClick="LocalEntriesGrid_OnMouseDoubleClick"
                          PreviewKeyDown="LocalEntriesGrid_OnPreviewKeyDown"
                          PreviewMouseLeftButtonDown="LocalEntriesGrid_OnPreviewMouseLeftButtonDown"
                          PreviewMouseRightButtonDown="FileGrid_OnPreviewMouseRightButtonDown"
                          MouseMove="LocalEntriesGrid_OnMouseMove"
                          DragOver="LocalEntriesGrid_OnDragOver"
                          Drop="LocalEntriesGrid_OnDrop"
                          Style="{StaticResource FileGridStyle}">
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="本地上级"
                                      Click="LocalNavigateUp_OnClick"
                                      IsEnabled="{Binding CanNavigateLocalUp}" />
                            <MenuItem Header="本地刷新"
                                      Click="LocalRefresh_OnClick"
                                      IsEnabled="{Binding CanInteractLocal}" />
                            <Separator />
                            <MenuItem Header="上传到远程"
                                      Click="LocalUploadMenuItem_OnClick"
                                      IsEnabled="{Binding CanUploadSelection}" />
                            <MenuItem Header="重命名"
                                      Click="LocalRenameMenuItem_OnClick"
                                      IsEnabled="{Binding CanRenameLocalSelection}" />
                            <MenuItem Header="删除本地项"
                                      Click="LocalDeleteMenuItem_OnClick"
                                      IsEnabled="{Binding CanDeleteLocalSelection}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="3*"
                                                CellTemplate="{StaticResource NameWithIconTemplate}"
                                                Header="文件名" />
                        <DataGridTextColumn Width="120"
                                            Binding="{Binding SizeDisplay}"
                                            ElementStyle="{StaticResource RightAlignedCellTextStyle}"
                                            Header="文件大小"
                                            HeaderStyle="{StaticResource RightAlignedHeaderStyle}" />
                        <DataGridTextColumn Width="140"
                                            Binding="{Binding TypeLabel}"
                                            Header="文件类型" />
                        <DataGridTextColumn Width="180"
                                            Binding="{Binding LastWriteDisplay}"
                                            Header="最近修改" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          HorizontalAlignment="Stretch"
                          Background="#FFE6ECF3"
                          ResizeBehavior="PreviousAndNext" />

            <Grid Grid.Column="2">
                <Border Style="{StaticResource PaneBorderStyle}">
                    <DataGrid x:Name="RemoteEntriesGrid"
                              AllowDrop="True"
                              ItemsSource="{Binding Entries}"
                              IsEnabled="{Binding CanSelectRemoteEntries}"
                              SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                              MouseDoubleClick="EntriesGrid_OnMouseDoubleClick"
                              PreviewKeyDown="RemoteEntriesGrid_OnPreviewKeyDown"
                              PreviewMouseLeftButtonDown="RemoteEntriesGrid_OnPreviewMouseLeftButtonDown"
                              PreviewMouseRightButtonDown="FileGrid_OnPreviewMouseRightButtonDown"
                              MouseMove="RemoteEntriesGrid_OnMouseMove"
                              DragOver="RemoteEntriesGrid_OnDragOver"
                              Drop="RemoteEntriesGrid_OnDrop"
                              Style="{StaticResource FileGridStyle}">
                    <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="远程上级"
                                          Click="RemoteNavigateUp_OnClick"
                                          IsEnabled="{Binding CanNavigateRemoteUp}" />
                                <MenuItem Header="远程刷新"
                                          Click="RemoteRefresh_OnClick"
                                          IsEnabled="{Binding CanInteractRemote}" />
                                <Separator />
                                <MenuItem Header="下载到本地"
                                          Click="RemoteDownloadMenuItem_OnClick"
                                          IsEnabled="{Binding CanDownloadSelection}" />
                                <MenuItem Header="重命名"
                                          Click="RemoteRenameMenuItem_OnClick"
                                          IsEnabled="{Binding CanRenameSelection}" />
                                <MenuItem Header="删除远程项"
                                          Click="Delete_OnClick"
                                          IsEnabled="{Binding CanDeleteSelection}" />
                                <Separator />
                                <MenuItem Header="新建远程目录"
                                          Click="CreateFolder_OnClick"
                                          IsEnabled="{Binding CanInteractRemote}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="3*"
                                                    CellTemplate="{StaticResource NameWithIconTemplate}"
                                                    Header="文件名" />
                            <DataGridTextColumn Width="120"
                                                Binding="{Binding SizeDisplay}"
                                                ElementStyle="{StaticResource RightAlignedCellTextStyle}"
                                                Header="文件大小"
                                                HeaderStyle="{StaticResource RightAlignedHeaderStyle}" />
                            <DataGridTextColumn Width="180"
                                                Binding="{Binding LastWriteDisplay}"
                                                Header="最近修改" />
                            <DataGridTextColumn Width="180"
                                                Binding="{Binding Permissions}"
                                                Header="权限" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Background="#EDF6FAFD"
                        BorderBrush="#FFD6E4F0"
                        BorderThickness="1"
                        Visibility="{Binding OverlayVisibility}">
                    <StackPanel Width="380"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#FF0F172A"
                                   Text="{Binding OverlayTitle}" />
                        <TextBlock Margin="0,12,0,0"
                                   Foreground="#FF475569"
                                   TextWrapping="Wrap"
                                   Text="{Binding OverlayMessage}" />
                        <Button Width="120"
                                Margin="0,18,0,0"
                                Padding="12,6"
                                HorizontalAlignment="Left"
                                Click="Retry_OnClick"
                                Content="重试连接"
                                Visibility="{Binding RetryVisibility}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="3"
              Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="8,5"
                    Style="{StaticResource PaneBorderStyle}">
                <TextBlock Text="{Binding LocalSummaryText}" />
            </Border>

            <Border Grid.Column="2"
                    Padding="8,5"
                    Style="{StaticResource PaneBorderStyle}">
                <TextBlock Text="{Binding RemoteSummaryText}" />
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Margin="0,8,0,0"
                Style="{StaticResource PaneBorderStyle}">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Padding="8,6"
                        Background="#FFF4F7FB"
                        BorderBrush="#FFD7E0EA"
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Text="传输日志" />
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Padding="10,3"
                                    Click="CancelSelectedTransfers_OnClick"
                                    Content="放弃选中"
                                    IsEnabled="{Binding CanCancelSelectedTransfers}" />
                            <Button Padding="10,3"
                                    Margin="0,0,8,0"
                                    Click="CancelAllTransfers_OnClick"
                                    Content="放弃全部"
                                    IsEnabled="{Binding CanCancelAllTransfers}" />
                            <Button Padding="10,3"
                                    Click="ClearTransferLogs_OnClick"
                                    Content="清空记录"
                                    IsEnabled="{Binding CanClearTransferLogs}" />
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right"
                                   Margin="0,0,12,0"
                                   DockPanel.Dock="Right"
                                   Foreground="#FF475569"
                                   Text="{Binding TransferLogSummaryText}" />
                    </DockPanel>
                </Border>

                <DataGrid x:Name="TransferLogsGrid"
                          ItemsSource="{Binding TransferLogs}"
                          SelectionMode="Extended"
                          PreviewMouseRightButtonDown="TransferLogsGrid_OnPreviewMouseRightButtonDown"
                          SelectionChanged="TransferLogsGrid_OnSelectionChanged"
                          Style="{StaticResource LogGridStyle}">
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="放弃选中"
                                      Click="CancelSelectedTransfers_OnClick"
                                      IsEnabled="{Binding CanCancelSelectedTransfers}" />
                            <MenuItem Header="放弃全部"
                                      Click="CancelAllTransfers_OnClick"
                                      IsEnabled="{Binding CanCancelAllTransfers}" />
                            <Separator />
                            <MenuItem Header="清空记录"
                                      Click="ClearTransferLogs_OnClick"
                                      IsEnabled="{Binding CanClearTransferLogs}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="150"
                                            Binding="{Binding TimestampDisplay}"
                                            Header="时间" />
                        <DataGridTextColumn Width="80"
                                            Binding="{Binding Direction}"
                                            Header="方向" />
                        <DataGridTextColumn Width="80"
                                            Binding="{Binding Status}"
                                            Header="状态" />
                        <DataGridTemplateColumn Width="220"
                                                Header="进度">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,0">
                                        <ProgressBar Minimum="0"
                                                     Maximum="100"
                                                     Height="16"
                                                     Value="{Binding ProgressPercent}" />
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Text="{Binding ProgressText}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="3*"
                                            Binding="{Binding LocalPath}"
                                            Header="本地文件" />
                        <DataGridTextColumn Width="3*"
                                            Binding="{Binding RemotePath}"
                                            Header="远程文件" />
                        <DataGridTextColumn Width="110"
                                            Binding="{Binding FileSizeText}"
                                            ElementStyle="{StaticResource RightAlignedCellTextStyle}"
                                            Header="文件大小"
                                            HeaderStyle="{StaticResource RightAlignedHeaderStyle}" />
                        <DataGridTextColumn Width="110"
                                            Binding="{Binding TransferSpeedText}"
                                            ElementStyle="{StaticResource RightAlignedCellTextStyle}"
                                            Header="传输速度"
                                            HeaderStyle="{StaticResource RightAlignedHeaderStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="5"
                Margin="0,8,0,0"
                Padding="10,7"
                Background="#FFF5F7FA"
                BorderBrush="#FFD3DCE6"
                BorderThickness="1">
            <TextBlock Text="{Binding StatusText}" />
        </Border>
    </Grid>
</Window>
