<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WiseShellSetup</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">1.0.0</VersionPrefix>
    <InstallerBuildStamp Condition="'$(InstallerBuildStamp)' == ''">$([System.DateTime]::Now.ToString('yyyyMMdd-HHmmss'))</InstallerBuildStamp>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(VersionPrefix)+$(InstallerBuildStamp)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InstallerRuntimeIdentifier Condition="'$(InstallerRuntimeIdentifier)' == ''">win-x64</InstallerRuntimeIdentifier>
    <InstallerOutputDir>$(MSBuildThisFileDirectory)bin\$(Configuration)\</InstallerOutputDir>
    <InstallerSingleFilePublishDir>$(MSBuildProjectDirectory)\obj\$(Configuration)\setup-publish\</InstallerSingleFilePublishDir>
    <InstallerPayloadDir>$(MSBuildThisFileDirectory)..\artifacts\installer-publish\$(Configuration)\$(InstallerRuntimeIdentifier)</InstallerPayloadDir>
    <InstallerPayloadZip>$(MSBuildProjectDirectory)\obj\$(Configuration)\WiseShellPayload.zip</InstallerPayloadZip>
    <InstallerBuildInfoFile>$(InstallerPayloadDir)\WiseShell.Installer.BuildInfo.txt</InstallerBuildInfoFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WiseShell.App\WiseShell.App.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <EmbeddedResource Include="$(InstallerPayloadZip)" LogicalName="WiseShellPayload.zip" />
  </ItemGroup>

  <Target Name="BuildInstallerPayload" BeforeTargets="BeforeCompile" Condition="'$(SkipInstallerPublish)' != 'true'">
    <RemoveDir Directories="$(InstallerPayloadDir)" />
    <MSBuild
      Projects="..\WiseShell.App\WiseShell.App.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(InstallerRuntimeIdentifier);SelfContained=false;PublishSingleFile=false;PublishDir=$(InstallerPayloadDir)" />
    <WriteLinesToFile
      File="$(InstallerBuildInfoFile)"
      Lines="WiseShell installer build: $(InformationalVersion)"
      Overwrite="true" />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Delete Files="$(InstallerPayloadZip)" />
    <ZipDirectory
      SourceDirectory="$(InstallerPayloadDir)"
      DestinationFile="$(InstallerPayloadZip)"
      Overwrite="true" />
  </Target>

  <Target Name="PublishSingleFileInstaller" AfterTargets="Build" Condition="'$(SkipInstallerPublish)' != 'true'">
    <RemoveDir Directories="$(InstallerSingleFilePublishDir)" />
    <MSBuild
      Projects="$(MSBuildProjectFullPath)"
      Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(InstallerRuntimeIdentifier);SelfContained=true;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;DebugType=None;DebugSymbols=false;PublishDir=$(InstallerSingleFilePublishDir);SkipInstallerPublish=true;VersionPrefix=$(VersionPrefix);InstallerBuildStamp=$(InstallerBuildStamp);InformationalVersion=$(InformationalVersion)" />
    <MakeDir Directories="$(InstallerOutputDir)" />
    <Delete Files="$(InstallerOutputDir)$(AssemblyName).exe" />
    <Copy
      SourceFiles="$(InstallerSingleFilePublishDir)$(AssemblyName).exe"
      DestinationFolder="$(InstallerOutputDir)" />
  </Target>

</Project>
